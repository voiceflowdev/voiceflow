{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow",
  "version": "1.0.5",
  "identifier": "com.voiceflow.pc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VoiceFlow",
        "label": "main",
        "width": 320,
        "height": 70,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/voiceflowdev/voiceflow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNTY0QkYzRDM3MTIzQ0EKUldUS0kzSFQ4MHRXN2t1TS9rWWFYcGk3OUwvVTlNMEdiV3Y3bUhtMCtWcXc4SXVqOGQzbHJpcHQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
